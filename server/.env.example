PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/clinic
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Optional: forward email/SMS/WhatsApp to a gateway adapter (default: log to console)
# NOTIFY_WEBHOOK_URL=https://example.com/send

# Files and backups (both contain patient data: keep them off git and on encrypted storage)
# UPLOAD_DIR=uploads
# BACKUP_DIR=backups
# BACKUP_HOUR=2        # take the daily backup after this hour
# BACKUP_KEEP=14       # how many backups to keep

# PDFs use Latin-only built-in fonts; for Devanagari or other scripts point to a TTF, e.g. Noto Sans
# PDF_FONT=/path/to/NotoSans-Regular.ttf
# PDF_FONT_BOLD=/path/to/NotoSans-Bold.ttf

# Optional AI chart summaries. Off by default ("rules" = built-in summary that never leaves the server).
# With "anthropic", only a de-identified summary of the chart (no name, phone, email or IDs) is sent.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# AI_MODEL=claude-sonnet-5-5
